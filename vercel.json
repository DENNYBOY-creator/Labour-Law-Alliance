{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    { "path": "/api/reminders", "schedule": "0 4 * * *" }
  ],
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [{ "type": "host", "value": "labour-kappa.vercel.app" }],
      "destination": "https://labourlawalliance.co.za/$1",
      "permanent": true
    },
    {
      "source": "/wp-admin/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-login.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home-page",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/#expertise",
      "permanent": false
    },
    {
      "source": "/services/restructuring-retrenchments",
      "destination": "/services/retrenchments-section-189",
      "permanent": true
    },
    {
      "source": "/services/hr-employment-contracts",
      "destination": "/services/employment-contracts-hr-policies",
      "permanent": true
    },
    {
      "source": "/services/labour-law-hr-workshops",
      "destination": "/services/labour-law-training-workshops",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/onboard",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
